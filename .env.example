# --- Primary LLM ---------------------------------------------------------
# One of: anthropic | openai | gemini
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-5-5

# --- Optional fallback (used if the primary fails or returns invalid JSON) -
FALLBACK_LLM_PROVIDER=anthropic
FALLBACK_LLM_MODEL=claude-sonnet-5-5

# --- API keys (only the ones you use). NEVER commit the real .env file ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Behaviour -------------------------------------------------------------
MAX_CONTENT_CHARS=20000        # cap on website text sent to the LLM
FETCH_TIMEOUT_SECONDS=12
MAX_DOWNLOAD_BYTES=2000000
EXTRA_PAGES=3                  # extra internal pages (about/services/...) to read
VERIFY_COMPETITORS=true        # fetch each suggested competitor's homepage
CACHE_TTL_SECONDS=3600
RATE_LIMIT_PER_MINUTE=10       # per client IP; 0 disables

# Optional: if set, clients must send header  X-API-Key: <value>
API_ACCESS_KEY=
